---
import Layout from '../layouts/Layout.astro';

const definitionCode = `// chip.props.ts: written once, shared by every framework
export const chipProps = {
  label: props.Text({ name: 'Label', group: 'Content', defaultValue: 'Chip' }),
  count: props.Number({ name: 'Count', group: 'Content', min: 0, max: 999, decimals: 0 }),
  color: props.Color({ name: 'Color', group: 'Style', defaultValue: '#e4572e' }),
} satisfies PropsConfig<ChipProps>;

// react/Chip.tinker.ts (same shape for solid, vue and vanilla)
export default declareComponent(Chip, { name: 'Chip', props: chipProps });

// anywhere, with any framework's definition
const chip = definition.mount(element, clientValues);
chip.update({ count: 5 });`;

const payload = JSON.stringify(
  { label: 'Hello', count: 99999, color: 'red', onClick: 'alert(1)', className: 'x' },
  null,
  2,
);
---

<Layout title="Tinker – Spicy Astro Playground" description="Expose only chosen component props to clients.">
  <h1>Tinker</h1>
  <p>
    Declare which props of a component clients may change. A <strong>definition</strong> carries
    a JSON <strong>manifest</strong> (for building a panel) and a <strong>validator</strong> (for
    untrusted input), and mounts the same way in React, Solid, Vue or plain JS.
  </p>

  <h2>Definition</h2>
  <pre><code>{definitionCode}</code></pre>

  <h2>Playground</h2>
  <p>One generated inspector drives the same chip in four frameworks.</p>
  <div class="shell">
    <div class="canvas" aria-label="Preview">
      <figure class="frame"><figcaption>React</figcaption><span id="mount-react"></span></figure>
      <figure class="frame"><figcaption>Solid</figcaption><span id="mount-solid"></span></figure>
      <figure class="frame"><figcaption>Vue</figcaption><span id="mount-vue"></span></figure>
      <figure class="frame"><figcaption>Vanilla</figcaption><span id="mount-vanilla"></span></figure>
    </div>
    <aside class="inspector" aria-label="Properties">
      <header>
        <span id="inspector-name" class="name"></span>
        <span class="kind">Properties</span>
      </header>
      <div id="panel"></div>
    </aside>
  </div>

  <h2>Validating client input</h2>
  <p>
    Whatever a client sends goes through <code>definition.resolve</code> or <code>mount</code>.
    Only exposed props get through, and values are clamped or replaced.
  </p>
  <div class="payload">
    <label>
      Payload (JSON)
      <textarea id="payload" rows="8" spellcheck="false">{payload}</textarea>
    </label>
    <div>
      <p class="caption">Resolved (what the component receives)</p>
      <pre id="resolved"></pre>
      <p class="caption">Dropped (not exposed)</p>
      <pre id="dropped"></pre>
    </div>
  </div>

  <h2>Manifest</h2>
  <p>JSON-safe. Store it, send it to a dashboard, validate with it. No component code needed.</p>
  <pre id="manifest"></pre>
</Layout>

<script>
  import '../lib/tinker/panel.css';
  import { createPanel } from '@spicy/tinker/panel';
  import { resolveValues } from '@spicy/tinker';
  import react from '../components/chip/react/Chip.tinker';
  import solid from '../components/chip/solid/Chip.tinker';
  import vue from '../components/chip/vue/Chip.tinker';
  import vanilla from '../components/chip/vanilla/Chip.tinker';

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const json = (value: unknown) => JSON.stringify(value, null, 2);

  // All four share one schema, so any definition's manifest describes them all.
  const manifest = react.manifest;
  byId('manifest').textContent = json(manifest);
  byId('inspector-name').textContent = manifest.name;

  // Raw values as typed into the panel. Each mount validates them itself.
  const values: Record<string, unknown> = Object.fromEntries(manifest.props.map((p) => [p.key, p.defaultValue]));

  const mounted = [
    react.mount(byId('mount-react'), values),
    solid.mount(byId('mount-solid'), values),
    vue.mount(byId('mount-vue'), values),
    vanilla.mount(byId('mount-vanilla'), values),
  ];

  const panel = createPanel(manifest, {
    values,
    onChange(key, value) {
      values[key] = value;
      mounted.forEach((m) => m.update({ [key]: value }));
    },
  });
  byId('panel').append(panel.element);

  const payload = byId<HTMLTextAreaElement>('payload');
  const showPayload = () => {
    try {
      const input = JSON.parse(payload.value);
      byId('resolved').textContent = json(resolveValues(manifest.props, input));
      byId('dropped').textContent = json(Object.keys(input).filter((k) => !manifest.props.some((p) => p.key === k)));
    } catch {
      byId('resolved').textContent = 'Not valid JSON';
      byId('dropped').textContent = '';
    }
  };
  payload.addEventListener('input', showPayload);
  showPayload();
</script>

<style>
  pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-size: 0.8rem;
  }
  .payload {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  /* An editor shell: canvas on the left, inspector on the right. Wider than the text column. */
  .shell {
    --inspector: 17.5rem;
    display: grid;
    grid-template-columns: 1fr var(--inspector);
    width: min(56rem, calc(100vw - 2rem));
    margin-left: 50%;
    transform: translateX(-50%);
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    overflow: hidden;
  }
  .canvas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-content: center;
    gap: 1rem;
    min-height: 18rem;
    padding: 1.5rem;
    background-color: #ececee;
    background-image: radial-gradient(#c3c3c8 1px, transparent 1px);
    background-size: 16px 16px;
    color: #222;
  }
  .frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 6rem;
    margin: 0;
    padding: 1.25rem 0.75rem 1rem;
    border: 1px dashed #a9a9b0;
    border-radius: 6px;
    background: #fff;
  }
  .frame figcaption {
    order: -1;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #777;
  }
  .inspector {
    border-left: 1px solid #3d3d3d;
    background: #2b2b2b;
    color: #d9d9d9;
    font: 12px/1.4 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .inspector header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.75rem;
    border-bottom: 1px solid #3d3d3d;
  }
  .inspector .name {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .inspector .kind {
    color: #8f8f8f;
  }
  @media (max-width: 40rem) {
    .shell {
      grid-template-columns: 1fr;
    }
    .canvas {
      min-height: 0;
      padding: 1rem;
      gap: 0.75rem;
    }
    .frame {
      min-height: 0;
      padding: 0.75rem 0.5rem;
      gap: 0.5rem;
    }
    .inspector {
      border-top: 1px solid #3d3d3d;
      border-left: 0;
    }
  }

  textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-top: 0.25rem;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.8rem;
  }
  .caption {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    opacity: 0.7;
  }
</style>
