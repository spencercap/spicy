---
interface Props {
  /** Component name shown at the top of the inspector. */
  name: string;
  /** Fit the parent's width instead of breaking out wider than the text column. */
  contained?: boolean;
}

const { name, contained = false } = Astro.props;
---

<!--
  An editor-style layout: preview canvas on the left, properties inspector on the right.
  Put `<figure class="frame">` blocks in the slot. A script fills `[data-panel]`, e.g. with
  the panel from `@spicy/tinker/panel`. Wider than the text column unless `contained`;
  stacks on narrow screens.
-->
<div class:list={['shell', { contained }]}>
  <div class="canvas" aria-label="Preview">
    <slot />
  </div>
  <aside class="inspector" aria-label="Properties">
    <header>
      <span class="name">{name}</span>
      <span class="kind">Properties</span>
    </header>
    <div data-panel></div>
  </aside>
</div>

<style>
  .shell {
    --inspector: 17.5rem;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr var(--inspector);
    width: min(56rem, calc(100vw - 2rem));
    margin-left: 50%;
    transform: translateX(-50%);
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    overflow: hidden;
  }
  .shell.contained {
    width: 100%;
    margin-left: 0;
    transform: none;
  }
  .canvas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-content: center;
    gap: 1rem;
    min-height: 18rem;
    padding: 1.5rem;
    background-color: #ececee;
    background-image: radial-gradient(#c3c3c8 1px, transparent 1px);
    background-size: 16px 16px;
    color: #222;
  }
  .canvas :global(.frame) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 6rem;
    margin: 0;
    padding: 1.25rem 0.75rem 1rem;
    border: 1px dashed #a9a9b0;
    border-radius: 6px;
    background: #fff;
  }
  .canvas :global(.frame figcaption) {
    order: -1;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #777;
  }
  .inspector {
    border-left: 1px solid #3d3d3d;
    background: #2b2b2b;
    color: #d9d9d9;
    font: 12px/1.4 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .inspector header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.75rem;
    border-bottom: 1px solid #3d3d3d;
  }
  .name {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .kind {
    color: #8f8f8f;
  }
  @media (max-width: 40rem) {
    .shell {
      grid-template-columns: 1fr;
    }
    .canvas {
      min-height: 0;
      padding: 1rem;
      gap: 0.75rem;
    }
    .canvas :global(.frame) {
      min-height: 0;
      padding: 0.75rem 0.5rem;
      gap: 0.5rem;
    }
    .inspector {
      border-top: 1px solid #3d3d3d;
      border-left: 0;
    }
  }
</style>
