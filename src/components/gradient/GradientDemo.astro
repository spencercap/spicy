---
import EditorShell from '../ui/EditorShell.astro';
import Gradient from './Gradient.astro';

const usage = `<Gradient start="#3b82f6" middle="#ec4899" end="#f59e0b" />`;
---

<p>
  A rounded gradient with three color stops, set through props. It blends in OKLCH, so the middle
  of the gradient stays colorful instead of fading to grey. The same component exists in Astro,
  React, Solid, Vue and plain JS.
</p>

<table>
  <thead>
    <tr><th>Prop</th><th>Type</th><th>Default</th></tr>
  </thead>
  <tbody>
    <tr><td><code>start</code></td><td>color</td><td><code>'#3b82f6'</code></td></tr>
    <tr><td><code>middle</code></td><td>color</td><td><code>'#ec4899'</code></td></tr>
    <tr><td><code>end</code></td><td>color</td><td><code>'#f59e0b'</code></td></tr>
  </tbody>
</table>

<h3>Instance</h3>
<Gradient />

<h3>Playground</h3>
<p>Change a stop in the inspector and every framework's gradient follows.</p>
<div data-gradient-demo>
  <EditorShell name="Gradient" contained>
    <figure class="frame"><figcaption>React</figcaption><div class="fill" data-mount="react"></div></figure>
    <figure class="frame"><figcaption>Solid</figcaption><div class="fill" data-mount="solid"></div></figure>
    <figure class="frame"><figcaption>Vue</figcaption><div class="fill" data-mount="vue"></div></figure>
    <figure class="frame"><figcaption>Vanilla</figcaption><div class="fill" data-mount="vanilla"></div></figure>
  </EditorShell>
</div>

<h3>Why OKLCH</h3>
<p>
  The same two colors, blue to orange. The usual blend averages the channels and turns muddy
  and grey in the middle. OKLCH goes around the color wheel instead, through pink, and stays vivid.
</p>
<div class="compare">
  <figure>
    <div class="bar srgb"></div>
    <figcaption>sRGB (CSS default)</figcaption>
  </figure>
  <figure>
    <div class="bar oklch"></div>
    <figcaption>OKLCH (this component)</figcaption>
  </figure>
</div>

<h3>Usage</h3>
<pre><code>{usage}</code></pre>

<script>
  import '../../lib/tinker/panel.css';
  import { createPanel } from '@spicy/tinker/panel';
  import react from './react/Gradient.tinker';
  import solid from './solid/Gradient.tinker';
  import vue from './vue/Gradient.tinker';
  import vanilla from './vanilla/Gradient.tinker';

  const root = document.querySelector<HTMLElement>('[data-gradient-demo]')!;
  const mountPoint = (name: string) => root.querySelector<HTMLElement>(`[data-mount=${name}]`)!;

  // All four share one schema, so any definition's manifest describes them all.
  const manifest = react.manifest;
  const values: Record<string, unknown> = Object.fromEntries(manifest.props.map((p) => [p.key, p.defaultValue]));

  const mounted = [
    react.mount(mountPoint('react'), values),
    solid.mount(mountPoint('solid'), values),
    vue.mount(mountPoint('vue'), values),
    vanilla.mount(mountPoint('vanilla'), values),
  ];

  const panel = createPanel(manifest, {
    values,
    onChange(key, value) {
      values[key] = value;
      mounted.forEach((m) => m.update({ [key]: value }));
    },
  });
  root.querySelector('[data-panel]')!.append(panel.element);
</script>

<style>
  table {
    border-collapse: collapse;
    margin-bottom: 1rem;
  }
  th,
  td {
    padding: 0.25rem 1rem 0.25rem 0;
    text-align: left;
  }
  pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  /* Gradients fill their frame instead of sitting centered like the chip */
  [data-gradient-demo] :global(.fill) {
    align-self: stretch;
  }
  [data-gradient-demo] :global(.fill .gradient) {
    min-height: 5rem;
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .compare figure {
    margin: 0;
  }
  .compare figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .bar {
    height: 4rem;
    border-radius: 1rem;
    background: linear-gradient(90deg, #2563eb, #f97316);
  }
  @supports (background: linear-gradient(in oklch, red, blue)) {
    .bar.oklch {
      background: linear-gradient(90deg in oklch, #2563eb, #f97316);
    }
  }
</style>
