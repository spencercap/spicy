---
import Chip from './Chip.astro';
import ChipEditor from './ChipEditor.astro';
import { ChipEditor as ReactChipEditor } from './react/Chip';
import { ChipEditor as SolidChipEditor } from './solid/Chip';

const examples = [
  { label: 'Default' },
  { label: 'Messages', count: 3, color: 'rebeccapurple' },
  { label: 'Errors', count: 12, color: '#d00000' },
  { label: 'Done', count: 100, color: 'hsl(140 60% 35%)' },
];
---

<p>
  A small badge. Each prop is set by whoever uses the component, so every instance can look
  different. The same component exists in Astro, React and Solid.
</p>

<table>
  <thead>
    <tr><th>Prop</th><th>Type</th><th>Default</th></tr>
  </thead>
  <tbody>
    <tr><td><code>label</code></td><td>string</td><td><code>'Chip'</code></td></tr>
    <tr><td><code>count</code></td><td>number</td><td><code>0</code></td></tr>
    <tr><td><code>color</code></td><td>CSS color</td><td><code>'#e4572e'</code></td></tr>
  </tbody>
</table>

<h3>Instances</h3>
<div class="row">
  {examples.map((props) => <Chip {...props} />)}
</div>

<h3>Usage</h3>
<pre><code>{`<Chip label="Messages" count={3} color="rebeccapurple" />`}</code></pre>

<h3>Live editors</h3>
<p>Edit the inputs and the chip updates as you type.</p>

<h4>Astro <small>(vanilla script)</small></h4>
<ChipEditor />

<h4>React</h4>
<ReactChipEditor client:load label="Messages" count={3} color="#663399" />

<h4>Solid</h4>
<SolidChipEditor client:load label="Messages" count={3} color="#663399" />

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  table {
    border-collapse: collapse;
    margin-bottom: 1rem;
  }
  th,
  td {
    padding: 0.25rem 1rem 0.25rem 0;
    text-align: left;
  }
  pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  h4 small {
    font-weight: 400;
    opacity: 0.6;
  }
</style>

<!-- Global because the React and Solid editors render outside this component's scoped styles. -->
<style is:global>
  .editor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 6px;
  }
  .editor .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  .editor input[type='text'],
  .editor input[type='number'] {
    width: 7rem;
  }
</style>
